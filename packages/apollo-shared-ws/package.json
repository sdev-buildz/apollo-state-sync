{
  "name": "apollo-shared-ws",
  "version": "0.0.1",
  "description": "Enables Apollo Clients to share a single WebSocket connection across browsing contexts (across browser tabs, windows, etc...).",
  "keywords": [
    "graphql",
    "web socket",
    "shared ws",
    "apollo link",
    "shared worker"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdev-buildz/apollo-shared-ws.git",
    "directory": "packages/apollo-shared-ws"
  },
  "license": "ISC",
  "author": {
    "name": "sdev-buildz",
    "email": "stevexdev@zohomail.in",
    "url": "https://github.com/sdev-buildz"
  },
  "type": "module",
  "bin": {
    "apollo-shared-ws": "dist/bin/bin.mjs"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@apollo/client": "catalog:",
    "@stricli/core": "catalog:",
    "graphql": "catalog:",
    "graphql-shared-ws": "catalog:"
  },
  "peerDependencies": {
    "@apollo/client": "catalog:peer-deps",
    "graphql-shared-ws": ">=0.0.0",
    "ts-morph": "catalog:"
  },
  "peerDependenciesMeta": {
    "ts-morph": {
      "optional": true
    }
  },
  "engines": {
    "node": "22.x || 24.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^11",
      "onFail": "warn"
    }
  },
  "devDependencies": {
    "@packages/common-utils": "workspace:*",
    "@packages/migration": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "graphql-ws": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/stevenx.dev"
  }
}
