  "devDependencies": {
    "@packages/web-app-utils": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "concurrently": "^10.0.5",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "webpack": "catalog:"
