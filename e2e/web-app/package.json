{
  "name": "e2e-web-app",
  "version": "0.0.0",
  "description": "web app used for e2e testing.",
  "private": true,
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "start-server": "tsx server/index.ts",
    "start-server-watch": "concurrently \"tsx --watch server/index.ts\" \"pnpm run codegen-watch\"",
    "start-react-watch": "tsx ./webpack/webpack.dev-server.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen-watch": "pnpm run codegen --watch",
    "print-graphql-sdl": "tsx ./printSdl.ts",
    "build-graphql": "pnpm run print-graphql-sdl && pnpm run codegen"
  },
  "dependencies": {
    "@apollo/client": "catalog:",
    "@packages/logger": "workspace:*",
    "@pothos/core": "^4.13.1",
    "apollo-state-sync": "workspace:*",
    "canonical-serialization": "catalog:",
    "graphql": "catalog:",
    "graphql-ws": "catalog:",
    "graphql-yoga": "^5.21.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.69.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.5",
    "@graphql-codegen/typescript-react-apollo": "^4.4.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "babel-loader": "^10.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.4",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "html-webpack-plugin": "^5.6.8",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.3.2",
    "style-loader": "^4.0.0",
    "ts-morph": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "webpack": "^5.101.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  }
}
