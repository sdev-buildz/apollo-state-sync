{
  "name": "@examples/shopping-site",
  "version": "0.0.0",
  "private": "true",
  "description": "A full-stack e-commerce application featuring authentication (signup/login), shopping cart management, and checkout processing, with real-time product count updates driven by WebSockets.",
  "type": "module",
  "scripts": {
    "start-server": "tsx server/index.ts",
    "start-server-watch": "concurrently \"tsx --watch server/index.ts\" \"pnpm run codegen-watch\"",
    "start-react-watch": "tsx ./webpack/webpack.dev-server.ts",
    "build-graphql": "tsx ./buildGql.ts"
  },
  "dependencies": {
    "@apollo/client": "catalog:",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/utils": "^9.4.0",
    "@packages/logger": "workspace:*",
    "@pothos/core": "catalog:",
    "apollo-shared-ws": "workspace:*",
    "apollo-state-sync": "workspace:*",
    "colorthief": "^3.5.0",
    "graphql": "catalog:",
    "graphql-ws": "catalog:",
    "graphql-yoga": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "uWebSockets.js": "catalog:"
  },
  "devDependencies": {
    "@packages/web-app-utils": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "concurrently": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "webpack": "catalog:"
  }
}
